# ──────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/souqone"

# ──────────────────────────────────────
# API Server
# ──────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000

# ──────────────────────────────────────
# Frontend (Next.js)
# ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────
# Authentication (JWT)
# ──────────────────────────────────────
JWT_SECRET=CHANGE_ME_NOT_A_REAL_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_NOT_A_REAL_SECRET
JWT_EXPIRATION=7d

# ──────────────────────────────────────
# Redis
# ──────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ──────────────────────────────────────
# Meilisearch
# ──────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=CHANGE_ME_NOT_A_REAL_SECRET

# ──────────────────────────────────────
# Google OAuth (optional)
# ──────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME_NOT_A_REAL_SECRET
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME_NOT_A_REAL_SECRET

# ──────────────────────────────────────
# Environment
# ──────────────────────────────────────
NODE_ENV=development

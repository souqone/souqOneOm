# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/souqone"
# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── JWT ──
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Google OAuth ──
GOOGLE_CLIENT_ID=change-me

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# ── MeiliSearch ──
# Local: http://localhost:7700
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=change-me
MEILI_MASTER_KEY=change-me

# ── Mail ──
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=change-me
MAIL_PASS=change-me
MAIL_FROM=noreply@souqone.com

# ── App ──
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/souqone"
# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── JWT & Auth Pepper ──
JWT_SECRET=CHANGE_ME_NOT_A_REAL_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_NOT_A_REAL_SECRET
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# AUTH_PEPPER: HMAC secret for OTP hashes (minimum 32 characters in production)
AUTH_PEPPER=CHANGE_ME_NOT_A_REAL_SECRET

# ── Google OAuth ──
GOOGLE_CLIENT_ID=CHANGE_ME_NOT_A_REAL_SECRET

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=CHANGE_ME_NOT_A_REAL_SECRET
CLOUDINARY_API_KEY=CHANGE_ME_NOT_A_REAL_SECRET
CLOUDINARY_API_SECRET=CHANGE_ME_NOT_A_REAL_SECRET

# ── MeiliSearch ──
# Local: http://localhost:7700
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=CHANGE_ME_NOT_A_REAL_SECRET
MEILI_MASTER_KEY=CHANGE_ME_NOT_A_REAL_SECRET

# ── Mail ──
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=CHANGE_ME_NOT_A_REAL_SECRET
MAIL_PASS=CHANGE_ME_NOT_A_REAL_SECRET
MAIL_FROM=noreply@mail.souqoneom.com
MAIL_REPLY_TO=support@souqoneom.com

# ── App ──
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Phone Allowed Country Codes ──
# قائمة أكواد الدول المسموحة لأرقام الهواتف (مفصولة بفاصلة، الافتراضي: 968 في الإنتاج، و 968,20 في غير الإنتاج. ترك المتغير معلّقاً أو فارغاً يطبّق الافتراضي)
# PHONE_ALLOWED_COUNTRY_CODES=968,20

# ── WhatsApp OTP & Meta Cloud API (Part 8 PR2) ──
# مزود خدمة رسائل واتساب: meta أو mock (الافتراضي في غير الإنتاج: mock. في الإنتاج: meta إلزامي)
# WHATSAPP_PROVIDER=mock
# معرف رقم هاتف واتساب التجاري من لوحة مطوري Meta
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# رمز الوصول الدائم (System User Access Token) لحساب أعمال Meta
# WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token_here
# اسم قالب المصادقة المعتمد في واتساب
# WHATSAPP_TEMPLATE_NAME=auth_otp
# لغة قالب المصادقة (الافتراضي: ar)
# WHATSAPP_TEMPLATE_LANG=ar
# إصدار Meta Graph API (الافتراضي: v21.0)
# WHATSAPP_GRAPH_VERSION=v21.0
# السر المشترك لتطبيق Meta للتحقق من توقيع الـ Webhook (X-Hub-Signature-256)
# WHATSAPP_APP_SECRET=your_meta_app_secret_here
# رمز التحقق العشوائي لمصافحة Webhook من Meta (hub.verify_token)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
# السقف اليومي العام لرسائل OTP عبر واتساب (الافتراضي: 200 بتوقيت UTC)
# WHATSAPP_DAILY_CAP=200
